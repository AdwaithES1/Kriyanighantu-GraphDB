# Copy to .env and choose your own password (8+ characters). Never commit .env.
NEO4J_PASSWORD=change-me-please
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Ports: the usual defaults + 6, to avoid clashes on shared servers. Change any that are taken,
# then run: sh setup_linux.sh
# APP_PORT is the website (open to the network); the two Neo4j ports are reachable from this machine only.
APP_PORT=5006
NEO4J_BOLT_PORT=7693
NEO4J_HTTP_PORT=7480

# Where the app finds Neo4j. setup_linux.sh rewrites this to match NEO4J_BOLT_PORT.
# The Windows install (start.bat) uses 7688.
NEO4J_URI=bolt://localhost:7693
