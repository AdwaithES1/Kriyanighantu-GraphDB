# Copy to .env and choose your own password (8+ characters). Never commit .env.
NEO4J_PASSWORD=change-me-please
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Windows local install (start.bat) uses 7688; a plain Linux install of Neo4j uses 7687.
# Docker Compose sets this itself, so it is ignored there.
NEO4J_URI=bolt://localhost:7688

# Port for the web app (Docker Compose and serve.sh). Change it if 5000 is taken, e.g. 5007.
APP_PORT=5000
